# =====================================================================
#  VOX Normalizer — what is kept out of the public repository
#
#  Rule of thumb: publish the app source and what is needed to build it.
#  Working notes, marketing assets and one-off scripts stay local.
# =====================================================================

# ---- Regenerated by the Projucer from the .jucer ----
Builds/
JuceLibraryCode/

# ---- Build output (releases are published through GitHub Releases) ----
build/
dist/
*.dmg
*.pkg
*.zip
*.app/
*.aaxplugin/
# Generated by create_icon.py (can be rebuilt from the PNGs)
AppIcon.icns

# ---- Internal working notes (always excluded) ----
*_Handoff.md
Booth_product_description.md

# ---- The old manual PDFs (the website covers this now) ----
*.pdf

# ---- Marketing assets (not needed in a code repository) ----
booth_assets/
*.mov

# ---- Icon and font exploration (not needed to build) ----
icon_v2/
# 31MB of fonts that are not used by the build. Redistributing them would need a licence check.
Fonts/
check_fonts.py
check_sfns.py
font_compare.py
font_compare.png

# ---- Superseded when v1.2 moved from .dmg to .pkg ----
make_dmg.sh
dmg_assets/

# ---- Old-style source backups (unnecessary now the project is in git) ----
backup_v*/

# ---- macOS ----
.DS_Store
._*
.Spotlight-V100
.Trashes

# ---- Editors ----
.vscode/
.idea/
*.swp
xcuserdata/

# ---- Python ----
__pycache__/
*.pyc
